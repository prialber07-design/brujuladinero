---
import { SITE } from '../../site.config';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import BannerCookies from '../components/BannerCookies.astro';
import EsquemaSitio from '../components/EsquemaSitio.astro';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  tipo?: 'website' | 'article';
  noIndexar?: boolean;
  publicado?: Date;
  modificado?: Date;
  conProgreso?: boolean;
}

const {
  titulo, descripcion, tipo = 'website', noIndexar = false,
  publicado, modificado, conProgreso = false,
} = Astro.props;

const canonica = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const tituloCompleto = titulo === SITE.nombre ? titulo : `${titulo} | ${SITE.nombre}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />

    {noIndexar ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      /* max-snippet:-1 autoriza fragmentos largos: es lo que permite que
         Google y los motores de IA citen un párrafo entero en vez de dos
         líneas sueltas. max-image-preview:large da tarjeta grande. */
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}

    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={new URL(SITE.imagenSocial, SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={new URL(SITE.imagenSocial, SITE.url).href} />
    <meta name="theme-color" content="#1f6f5c" />

    <meta name="author" content={SITE.autor.nombre} />
    <link rel="author" href={`${SITE.url}/sobre-mi/`} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Resumen del sitio para motores de IA" />

    {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
    {modificado && <meta property="article:modified_time" content={modificado.toISOString()} />}

    <link rel="alternate" type="application/rss+xml" title={SITE.nombre} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {SITE.adsense.scriptEnCabecera && SITE.adsense.publisherId && (
      <Fragment>
        {/* Modo de consentimiento por defecto: TODO DENEGADO.
            Tiene que ejecutarse ANTES que el script de AdSense; si no, hay
            una ventana de milisegundos en la que se ejecutaría sin
            restricción. El banner lo actualiza a "granted" si el usuario
            acepta. */}
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500
          });
        </script>

        {/* AdSense. Va en el <head> porque es donde Google lo busca para
            verificar y revisar el sitio. Para el tráfico del EEE hace falta
            además una plataforma de consentimiento certificada: la de Google
            es gratuita y se activa en el panel de AdSense. Ver README. */}
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsense.publisherId}`}
          crossorigin="anonymous"
        />
      </Fragment>
    )}

    {/* Aplica el tema guardado antes de pintar, para que no haya destello */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('tema');
          if (t) document.documentElement.setAttribute('data-tema', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <EsquemaSitio />
    {conProgreso && <div class="progreso" id="barra-progreso"></div>}
    <Cabecera />
    <main class="contenedor">
      <slot />
    </main>
    <Pie />
    <BannerCookies />

    {conProgreso && (
      <script is:inline>
        (function () {
          var barra = document.getElementById('barra-progreso');
          if (!barra) return;
          var pendiente = false;
          function pintar() {
            var alto = document.documentElement.scrollHeight - window.innerHeight;
            var pct = alto > 0 ? (window.scrollY / alto) * 100 : 0;
            barra.style.width = Math.min(100, Math.max(0, pct)) + '%';
            pendiente = false;
          }
          window.addEventListener('scroll', function () {
            if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); }
          }, { passive: true });
          pintar();
        })();
      </script>
    )}
  </body>
</html>
