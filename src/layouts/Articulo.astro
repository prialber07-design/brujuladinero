---
import { SITE, CATEGORIAS } from '../../site.config';
import Base from './Base.astro';

interface Props {
  titulo: string;
  descripcion: string;
  categoria: string;
  fecha: Date;
  actualizado?: Date;
  autor: string;
  borrador: boolean;
  faltaAporteReal: boolean;
}

const { titulo, descripcion, categoria, fecha, actualizado, autor, borrador, faltaAporteReal } =
  Astro.props;

const cat = CATEGORIAS.find((c) => c.slug === categoria);
const url = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

const formatear = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

// Datos estructurados. En un nicho YMYL como finanzas, dejar clara la
// autoría es de lo que más pesa a ojos de Google.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: descripcion,
  datePublished: fecha.toISOString(),
  dateModified: (actualizado ?? fecha).toISOString(),
  author: { '@type': 'Person', name: autor, url: `${SITE.url}/sobre-mi/` },
  publisher: { '@type': 'Organization', name: SITE.nombre, url: SITE.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: 'es-ES',
};

const enDesarrollo = import.meta.env.DEV;
---

<Base
  titulo={titulo}
  descripcion={descripcion}
  tipo="article"
  noIndexar={borrador}
  publicado={fecha}
  modificado={actualizado}
>
  <article class="estrecho contenedor" style="padding:0">
    {enDesarrollo && (borrador || faltaAporteReal) && (
      <div class="aviso-borrador">
        <strong>Solo visible en local.</strong>
        {borrador && <span> Este artículo está marcado como borrador.</span>}
        {faltaAporteReal && (
          <span>
            {' '}Falta tu aportación personal: añade al menos un párrafo con tu experiencia real
            y verifica los datos antes de publicar. Después pon <code>faltaAporteReal: false</code>.
          </span>
        )}
      </div>
    )}

    <div class="meta">
      {cat && <a class="etiqueta" href={`/categoria/${cat.slug}/`}>{cat.nombre}</a>}
      <time datetime={fecha.toISOString()}>{formatear(fecha)}</time>
      {actualizado && <span>· Actualizado el {formatear(actualizado)}</span>}
      <span>· Por {autor}</span>
    </div>

    <h1>{titulo}</h1>
    <p style="color:var(--texto-suave);font-size:1.15rem;margin-top:0">{descripcion}</p>

    <slot />

    <p class="aviso-legal-corto">
      Este artículo es divulgativo y no constituye asesoramiento financiero, fiscal ni de inversión.
      La normativa cambia: contrasta siempre con fuentes oficiales o con un profesional
      antes de tomar decisiones.
    </p>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>
