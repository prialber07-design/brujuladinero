---
import { ruta } from '../lib/rutas';
import type { MarkdownHeading } from 'astro';
import { SITE, CATEGORIAS } from '../../site.config';
import Base from './Base.astro';
import Icono from '../components/Icono.astro';
import MigaDePan from '../components/MigaDePan.astro';
import Ilustracion from '../components/Ilustracion.astro';
import PuntosClave from '../components/PuntosClave.astro';
import Resumen from '../components/Resumen.astro';
import Faq from '../components/Faq.astro';
import Indice from '../components/Indice.astro';
import Anuncio from '../components/Anuncio.astro';
import AvisoAfiliado from '../components/AvisoAfiliado.astro';
import Fuentes from '../components/Fuentes.astro';
import CajaAutor from '../components/CajaAutor.astro';
import Relacionados from '../components/Relacionados.astro';

interface Props {
  slug: string;
  titulo: string;
  descripcion: string;
  categoria: string;
  fecha: Date;
  actualizado?: Date;
  autor: string;
  borrador: boolean;
  faltaAporteReal: boolean;
  puntosClave?: readonly string[];
  fuentes?: readonly { texto: string; url?: string }[];
  tieneAfiliados: boolean;
  encabezados: MarkdownHeading[];
  minutos: number;
  ilustracion?: string;
  ilustracionAlt?: string;
  resumen?: string;
  faq?: readonly { pregunta: string; respuesta: string }[];
  temas?: readonly string[];
  palabras: number;
}

const {
  slug, titulo, descripcion, categoria, fecha, actualizado, autor,
  borrador, faltaAporteReal, puntosClave = [], fuentes = [],
  tieneAfiliados, encabezados, minutos,
  ilustracion, ilustracionAlt,
  resumen, faq = [], temas = [], palabras,
} = Astro.props;

const cat = CATEGORIAS.find((c) => c.slug === categoria);
const url = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

const formatear = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });

// Datos estructurados. En un nicho YMYL como finanzas, dejar clara la
// autoría es de lo que más pesa a ojos de Google.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: descripcion,
  ...(resumen && { abstract: resumen }),
  datePublished: fecha.toISOString(),
  dateModified: (actualizado ?? fecha).toISOString(),
  // Referencia a las entidades declaradas en EsquemaSitio, en vez de
  // duplicarlas: así Google consolida un único autor y un único editor.
  author: { '@id': `${SITE.url}/#autor` },
  publisher: { '@id': `${SITE.url}/#organizacion` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: 'es-ES',
  articleSection: cat?.nombre,
  wordCount: palabras,
  timeRequired: `PT${minutos}M`,
  image: new URL(SITE.imagenSocial, SITE.url).href,
  isAccessibleForFree: true,
  ...(temas.length > 0 && {
    keywords: temas.join(', '),
    about: temas.map((t) => ({ '@type': 'Thing', name: t })),
  }),
  ...(fuentes.length > 0 && {
    citation: fuentes.map((f) => ({
      '@type': 'CreativeWork',
      name: f.texto,
      ...(f.url && { url: f.url }),
    })),
  }),
};

const enDesarrollo = import.meta.env.DEV;
---

<Base
  titulo={titulo}
  descripcion={descripcion}
  tipo="article"
  noIndexar={borrador}
  publicado={fecha}
  modificado={actualizado}
  conProgreso
>
  <MigaDePan categoria={cat} actual={titulo} />

  {enDesarrollo && (borrador || faltaAporteReal) && (
    <div class="aviso-borrador">
      <strong>Solo visible en local.</strong>
      {borrador && <span> Este artículo está marcado como borrador.</span>}
      {faltaAporteReal && (
        <span>
          {' '}Falta tu aportación personal: añade al menos un párrafo con tu experiencia real
          y verifica los datos antes de publicar. Después pon <code>faltaAporteReal: false</code>.
        </span>
      )}
    </div>
  )}

  <div class="rejilla-articulo" data-cat={categoria}>
    <article>
      <header class="articulo-cabecera lectura">
        {cat && <a class="etiqueta" href={ruta(`/categoria/${cat.slug}/`)}>{cat.nombre}</a>}
        <h1>{titulo}</h1>
        <p class="entradilla">{descripcion}</p>
        <div class="meta">
          <span class="meta-item">
            <Icono nombre="persona" tam={14} /> Por <strong>{autor}</strong>
          </span>
          <span class="meta-item">
            <Icono nombre="calendario" tam={14} />
            <time datetime={fecha.toISOString()}>{formatear(fecha)}</time>
            {actualizado && <span>· Act. {formatear(actualizado)}</span>}
          </span>
          <span class="meta-item">
            <Icono nombre="reloj" tam={14} /> {minutos} min de lectura
          </span>
        </div>
      </header>

      <div class="lectura">
        {ilustracion && (
          <Ilustracion nombre={ilustracion} alt={ilustracionAlt ?? titulo} />
        )}
        {resumen && <Resumen texto={resumen} />}
        <PuntosClave puntos={puntosClave} />

        {/* Índice plegable: solo en móvil y tablet. En escritorio va fijo en la lateral. */}
        <div style="display:block" class="indice-movil">
          <Indice encabezados={encabezados} variante="plegable" />
        </div>

        <div class="cuerpo">
          <slot />
        </div>

        {tieneAfiliados && <AvisoAfiliado />}

        <Faq faq={faq} />

        <Anuncio formato="rectangulo" />

        <Fuentes fuentes={fuentes} />

        <aside class="aviso-divulgativo">
          <p>
            <strong>Aviso divulgativo:</strong> este contenido es exclusivamente educativo y no
            constituye asesoramiento financiero, fiscal ni de inversión. La normativa cambia y
            los productos financieros conllevan riesgo de pérdida de capital. Contrasta siempre
            con fuentes oficiales o con un profesional antes de decidir.
          </p>
        </aside>

        <CajaAutor autor={autor} />

        <Relacionados actual={slug} categoria={categoria} />
      </div>
    </article>

    <aside class="lateral">
      <Indice encabezados={encabezados} variante="lateral" />
      <Anuncio formato="lateral" />
    </aside>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style>
  /* El índice plegable estorba en escritorio, donde ya está el de la lateral */
  @media (min-width: 1024px) {
    .indice-movil { display: none !important; }
  }
</style>
