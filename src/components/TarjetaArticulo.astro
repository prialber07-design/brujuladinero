---
import { CATEGORIAS } from '../../site.config';

interface Props {
  slug: string;
  titulo: string;
  descripcion: string;
  categoria: string;
  fecha: Date;
  mostrarCategoria?: boolean;
}

const { slug, titulo, descripcion, categoria, fecha, mostrarCategoria = true } = Astro.props;
const cat = CATEGORIAS.find((c) => c.slug === categoria);
---

<li class="tarjeta">
  <div class="tarjeta-meta">
    {mostrarCategoria && cat && <a class="etiqueta" href={`/categoria/${cat.slug}/`}>{cat.nombre}</a>}
    <time datetime={fecha.toISOString()}>
      {fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })}
    </time>
  </div>
  <h2><a href={`/${slug}/`}>{titulo}</a></h2>
  <p>{descripcion}</p>
</li>
