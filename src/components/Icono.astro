---
// SVG en línea. Evita cargar una librería de iconos por red, que en el
// diseño original eran dos peticiones bloqueantes a Google Fonts.
interface Props {
  nombre:
    | 'brujula' | 'calendario' | 'persona' | 'reloj' | 'chevron-derecha'
    | 'chevron-abajo' | 'bombilla' | 'info' | 'menu' | 'cerrar'
    | 'sol' | 'luna' | 'cartera' | 'bitcoin' | 'escudo' | 'periodico';
  tam?: number;
}
const { nombre, tam = 16 } = Astro.props;

const trazos: Record<string, string> = {
  'brujula': '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
  'calendario': '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  'persona': '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  'reloj': '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  'chevron-derecha': '<polyline points="9 18 15 12 9 6"/>',
  'chevron-abajo': '<polyline points="6 9 12 15 18 9"/>',
  'bombilla': '<path d="M9 18h6M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5"/>',
  'info': '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>',
  'menu': '<path d="M3 12h18M3 6h18M3 18h18"/>',
  'cerrar': '<path d="M18 6 6 18M6 6l12 12"/>',
  'sol': '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>',
  'luna': '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  'cartera': '<path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/>',
  'bitcoin': '<circle cx="12" cy="12" r="10"/><path d="M9.5 7.5h4a2.25 2.25 0 0 1 0 4.5h-4Zm0 4.5h4.5a2.25 2.25 0 0 1 0 4.5H9.5Zm0-4.5V6m0 12v-1.5m3-9V6m0 12v-1.5"/>',
  'escudo': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>',
  'periodico': '<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0V9h4"/><path d="M18 14h-8M18 10h-8M10 6h8"/>',
};
---

<svg
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={trazos[nombre]}
/>
