---
import { CATEGORIAS } from '../../../site.config';
import Base from '../../layouts/Base.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { articulosDeCategoria } from '../../lib/articulos';

export async function getStaticPaths() {
  return CATEGORIAS.map((c) => ({ params: { categoria: c.slug }, props: { cat: c } }));
}

const { cat } = Astro.props;
const articulos = await articulosDeCategoria(cat.slug);
---

<Base titulo={cat.nombre} descripcion={cat.descripcion}>
  <div class="estrecho">
    <h1>{cat.nombre}</h1>
    <p style="font-size:1.1rem;color:var(--texto-suave)">{cat.descripcion}</p>

    {articulos.length === 0 ? (
      <p style="color:var(--texto-suave)">Aún no hay artículos en esta categoría.</p>
    ) : (
      <ul class="lista-articulos" style="padding:0;margin-top:2.5rem">
        {articulos.map((a) => (
          <TarjetaArticulo
            slug={a.id}
            titulo={a.data.titulo}
            descripcion={a.data.descripcion}
            categoria={a.data.categoria}
            fecha={a.data.fecha}
            mostrarCategoria={false}
          />
        ))}
      </ul>
    )}
  </div>
</Base>
