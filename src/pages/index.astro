---
import { ruta } from '../lib/rutas';
import { SITE, CATEGORIAS } from '../../site.config';
import Base from '../layouts/Base.astro';
import TarjetaArticulo from '../components/TarjetaArticulo.astro';
import Anuncio from '../components/Anuncio.astro';
import Icono from '../components/Icono.astro';
import { articulosPublicados, minutosDeLectura } from '../lib/articulos';

const articulos = await articulosPublicados();

const iconos = {
  'finanzas-personales': 'cartera',
  'cripto-desde-cero': 'bitcoin',
  'fiscalidad-y-seguridad': 'escudo',
  'actualidad-explicada': 'periodico',
} as const;

// Ritmo editorial: una apertura a todo el ancho y tres piezas en lista.
// Una rejilla de tarjetas iguales no distingue lo importante de lo demás.
const apertura = articulos[0];
const secundarios = articulos.slice(1, 4);
const yaArriba = new Set([apertura, ...secundarios].filter(Boolean).map((a) => a.id));

// Después, cada sección con sus artículos más recientes. Con 30 artículos,
// una lista plana no deja ver que hay cuatro áreas distintas.
const secciones = CATEGORIAS.map((c) => {
  const suyos = articulos.filter((a) => a.data.categoria === c.slug);
  return {
    ...c,
    total: suyos.length,
    articulos: suyos.filter((a) => !yaArriba.has(a.id)),
  };
}).filter((s) => s.total > 0);
---

<Base titulo={SITE.nombre} descripcion={SITE.descripcion}>
  <section class="portada-intro">
    <h1>{SITE.nombre}</h1>
    <p class="lema">Tu guía serena en finanzas personales y criptomonedas</p>
    <p class="intro-texto">
      Aquí no vas a encontrar consejos de inversión ni promesas de hacerte rico.
      Encontrarás <strong>procedimientos</strong>: cómo funciona cada cosa, cuánto cuesta
      de verdad y qué pasos dar.
    </p>
  </section>

  {articulos.length === 0 ? (
    <div class="vacio">
      <h2>Todavía no hay artículos publicados</h2>
      <p>Los primeros llegan pronto.</p>
    </div>
  ) : (
    <Fragment>
      <section class="bloque-apertura" aria-labelledby="ultimo-titulo">
        <h2 id="ultimo-titulo" class="titulo-bloque">Lo último</h2>

        <ul class="lista-apertura">
          <TarjetaArticulo
            slug={apertura.id}
            titulo={apertura.data.titulo}
            descripcion={apertura.data.descripcion}
            categoria={apertura.data.categoria}
            fecha={apertura.data.fecha}
            minutos={minutosDeLectura(apertura)}
            ilustracion={apertura.data.ilustracion}
            ilustracionAlt={apertura.data.ilustracionAlt}
            variante="principal"
          />
        </ul>

        <ul class="lista-horizontal">
          {secundarios.map((a) => (
            <TarjetaArticulo
              slug={a.id}
              titulo={a.data.titulo}
              descripcion={a.data.descripcion}
              categoria={a.data.categoria}
              fecha={a.data.fecha}
              minutos={minutosDeLectura(a)}
              ilustracion={a.data.ilustracion}
              ilustracionAlt={a.data.ilustracionAlt}
              variante="horizontal"
            />
          ))}
        </ul>
      </section>

      {/* Mapa de secciones: para orientarse una vez visto de qué va la casa */}
      <nav class="mapa-secciones" aria-label="Secciones">
        {secciones.map((s) => (
          <a href={`#${s.slug}`} data-cat={s.slug} class="mapa-tarjeta">
            <span class="mapa-icono"><Icono nombre={iconos[s.slug]} tam={22} /></span>
            <span class="mapa-texto">
              <strong>{s.nombre}</strong>
              <span>{s.gancho}</span>
            </span>
            <span class="mapa-cuenta">{s.total}</span>
          </a>
        ))}
      </nav>

      <Anuncio formato="banner" />

      {secciones.map((s) => (
        <section class="seccion-categoria" id={s.slug} data-cat={s.slug} aria-labelledby={`t-${s.slug}`}>
          <header class="seccion-cabecera">
            <span class="seccion-icono"><Icono nombre={iconos[s.slug]} tam={24} /></span>
            <div>
              <h2 id={`t-${s.slug}`}>{s.nombre}</h2>
              <p>{s.descripcion}</p>
            </div>
            <a class="seccion-ver-todo" href={ruta(`/categoria/${s.slug}/`)}>
              Ver los {s.total} →
            </a>
          </header>

          {/* El primero de la sección lleva imagen y ocupa la columna ancha;
              el resto van en lista compacta al lado. Rejilla asimétrica. */}
          <div class="rejilla-seccion">
            {s.articulos[0] && (
              <ul class="lista-apertura">
                <TarjetaArticulo
                  slug={s.articulos[0].id}
                  titulo={s.articulos[0].data.titulo}
                  descripcion={s.articulos[0].data.descripcion}
                  categoria={s.articulos[0].data.categoria}
                  fecha={s.articulos[0].data.fecha}
                  minutos={minutosDeLectura(s.articulos[0])}
                  ilustracion={s.articulos[0].data.ilustracion}
                  ilustracionAlt={s.articulos[0].data.ilustracionAlt}
                  mostrarCategoria={false}
                  variante="horizontal"
                />
              </ul>
            )}

            <ul class="lista-compacta">
              {s.articulos.slice(1, 5).map((a) => (
                <TarjetaArticulo
                  slug={a.id}
                  titulo={a.data.titulo}
                  descripcion={a.data.descripcion}
                  categoria={a.data.categoria}
                  fecha={a.data.fecha}
                  minutos={minutosDeLectura(a)}
                  mostrarCategoria={false}
                  variante="compacta"
                />
              ))}
            </ul>
          </div>

          {s.total > 5 && (
            <a class="seccion-pie-enlace" href={ruta(`/categoria/${s.slug}/`)}>
              Ver los {s.total} artículos de {s.nombre.toLowerCase()} →
            </a>
          )}
        </section>
      ))}
    </Fragment>
  )}
</Base>
