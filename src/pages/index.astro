---
import { ruta } from '../lib/rutas';
import { SITE, CATEGORIAS } from '../../site.config';
import Base from '../layouts/Base.astro';
import TarjetaArticulo from '../components/TarjetaArticulo.astro';
import Anuncio from '../components/Anuncio.astro';
import Icono from '../components/Icono.astro';
import { articulosPublicados, minutosDeLectura } from '../lib/articulos';

const articulos = await articulosPublicados();

const iconos = {
  'finanzas-personales': 'cartera',
  'cripto-desde-cero': 'bitcoin',
  'fiscalidad-y-seguridad': 'escudo',
  'actualidad-explicada': 'periodico',
} as const;

/*
 * Portada en tres piezas:
 *   1. Qué es esto, dicho en dos frases.
 *   2. Un destacado por sección: se ve de un vistazo que hay cuatro áreas.
 *   3. Cada sección con el resto, y los índices en la barra lateral.
 *
 * El destacado de cada sección es el primero por orden de lectura, no el
 * más reciente: es la puerta de entrada al tema, y quien llega de fuera
 * necesita empezar por ahí y no por la última novedad.
 */
const secciones = CATEGORIAS.map((c) => {
  const suyos = articulos
    .filter((a) => a.data.categoria === c.slug)
    .sort((a, b) => a.data.orden - b.data.orden || b.data.fecha.valueOf() - a.data.fecha.valueOf());
  return { ...c, total: suyos.length, destacado: suyos[0], resto: suyos.slice(1) };
}).filter((s) => s.total > 0);

const ultimos = articulos.slice(0, 5);
---

<Base titulo={SITE.nombre} descripcion={SITE.descripcion}>
  {articulos.length === 0 ? (
    <div class="vacio">
      <h2>Todavía no hay artículos publicados</h2>
      <p>Los primeros llegan pronto.</p>
    </div>
  ) : (
    <Fragment>
      <section class="portada-presentacion">
        <h1>{SITE.nombre}</h1>
        <p class="lema">Finanzas personales y criptomonedas, explicadas para España</p>
        <p class="presentacion-texto">
          Aquí no vas a encontrar consejos de inversión ni promesas de hacerte rico.
          Encontrarás <strong>procedimientos</strong>: cómo funciona cada cosa, cuánto
          cuesta de verdad y qué pasos dar.
        </p>

        <ul class="presentacion-puntos">
          <li>
            <strong>Escrito para España.</strong> Los tramos, los plazos y los organismos
            son los de aquí, no una traducción de una web estadounidense.
          </li>
          <li>
            <strong>Con las cifras contrastadas.</strong> Cada artículo cita sus fuentes:
            Agencia Tributaria, Banco de España, CNMV, INE y BCE, con la fecha en que
            se consultaron.
          </li>
          <li>
            <strong>Sin dar por sabido nada.</strong> Si aparece un término técnico, se
            explica la primera vez que sale.
          </li>
        </ul>

        <p class="presentacion-datos">
          <strong>{articulos.length} artículos</strong> en {secciones.length} secciones ·
          Escribe <a href={ruta('/sobre-mi/')}>{SITE.autor.nombre}</a> ·
          <a href={ruta('/rss.xml')}>Sigue por RSS</a>
        </p>
      </section>

      <section class="franja-destacados" aria-labelledby="destacados-titulo">
        <h2 id="destacados-titulo" class="titulo-bloque">Por dónde empezar</h2>
        <ul class="lista-destacados">
          {secciones.map((s) => (
            <li class="destacado-seccion" data-cat={s.slug}>
              <a class="destacado-etiqueta" href={ruta(`/categoria/${s.slug}/`)}>
                <Icono nombre={iconos[s.slug]} tam={14} /> {s.nombre}
              </a>
              <ul class="lista-destacados-interna">
                <TarjetaArticulo
                  slug={s.destacado.id}
                  titulo={s.destacado.data.titulo}
                  descripcion={s.destacado.data.descripcion}
                  categoria={s.destacado.data.categoria}
                  fecha={s.destacado.data.fecha}
                  minutos={minutosDeLectura(s.destacado)}
                  ilustracion={s.destacado.data.ilustracion}
                  ilustracionAlt={s.destacado.data.ilustracionAlt}
                  mostrarCategoria={false}
                  variante="portada"
                />
              </ul>
            </li>
          ))}
        </ul>
      </section>

      <div class="rejilla-portada">
        <div class="rio">
          {secciones.map((s) => (
            <section class="seccion-categoria" id={s.slug} data-cat={s.slug} aria-labelledby={`t-${s.slug}`}>
              <header class="seccion-cabecera">
                <span class="seccion-icono"><Icono nombre={iconos[s.slug]} tam={24} /></span>
                <div>
                  <h2 id={`t-${s.slug}`}>{s.nombre}</h2>
                  <p>{s.descripcion}</p>
                </div>
                <a class="seccion-ver-todo" href={ruta(`/categoria/${s.slug}/`)}>
                  Ver los {s.total} →
                </a>
              </header>

              {/* Una pieza de entrada con foto y el resto en dos columnas de
                  texto. Cuatro tarjetas horizontales seguidas ocupaban 800px
                  por sección: había que hacer scroll para ver que existía la
                  siguiente. Así entran seis en el mismo alto. */}
              <ul class="lista-horizontal">
                {s.resto.slice(0, 1).map((a) => (
                  <TarjetaArticulo
                    slug={a.id}
                    titulo={a.data.titulo}
                    descripcion={a.data.descripcion}
                    categoria={a.data.categoria}
                    fecha={a.data.fecha}
                    minutos={minutosDeLectura(a)}
                    ilustracion={a.data.ilustracion}
                    ilustracionAlt={a.data.ilustracionAlt}
                    mostrarCategoria={false}
                    variante="horizontal"
                  />
                ))}
              </ul>

              <ul class="lista-doble">
                {s.resto.slice(1, 7).map((a) => (
                  <TarjetaArticulo
                    slug={a.id}
                    titulo={a.data.titulo}
                    descripcion={a.data.descripcion}
                    categoria={a.data.categoria}
                    fecha={a.data.fecha}
                    minutos={minutosDeLectura(a)}
                    mostrarCategoria={false}
                    variante="compacta"
                  />
                ))}
              </ul>

              {s.total > 8 && (
                <a class="seccion-pie-enlace" href={ruta(`/categoria/${s.slug}/`)}>
                  Ver los {s.total} artículos de {s.nombre.toLowerCase()} →
                </a>
              )}
            </section>
          ))}
        </div>

        <aside class="lateral">
          <nav class="lateral-caja" aria-labelledby="secciones-titulo">
            <h2 id="secciones-titulo">Secciones</h2>
            <ul class="lista-secciones">
              {secciones.map((s) => (
                <li data-cat={s.slug}>
                  <a href={ruta(`/categoria/${s.slug}/`)}>
                    <span class="mapa-icono"><Icono nombre={iconos[s.slug]} tam={18} /></span>
                    <span class="lista-secciones-texto">
                      <strong>{s.nombre}</strong>
                      <span>{s.gancho}</span>
                    </span>
                    <span class="mapa-cuenta">{s.total}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <nav class="lateral-caja" aria-labelledby="ultimos-titulo">
            <h2 id="ultimos-titulo">Lo último</h2>
            <ul class="lista-lateral">
              {ultimos.map((a) => (
                <li><a href={ruta(`/${a.id}/`)}>{a.data.titulo}</a></li>
              ))}
            </ul>
          </nav>

          <Anuncio formato="lateral" />
        </aside>
      </div>
    </Fragment>
  )}
</Base>
