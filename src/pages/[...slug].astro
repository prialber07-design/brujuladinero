---
import { render } from 'astro:content';
import Articulo from '../layouts/Articulo.astro';
import { articulosPublicados } from '../lib/articulos';

export async function getStaticPaths() {
  const articulos = await articulosPublicados();
  return articulos.map((articulo) => ({
    params: { slug: articulo.id },
    props: { articulo },
  }));
}

const { articulo } = Astro.props;
const { Content, headings } = await render(articulo);

// Tiempo de lectura: ~200 palabras por minuto en castellano.
const palabras = articulo.body?.split(/\s+/).filter(Boolean).length ?? 0;
const minutos = Math.max(1, Math.round(palabras / 200));
---

<Articulo
  slug={articulo.id}
  titulo={articulo.data.titulo}
  descripcion={articulo.data.descripcion}
  categoria={articulo.data.categoria}
  fecha={articulo.data.fecha}
  actualizado={articulo.data.actualizado}
  autor={articulo.data.autor}
  borrador={articulo.data.borrador}
  faltaAporteReal={articulo.data.faltaAporteReal}
  puntosClave={articulo.data.puntosClave}
  fuentes={articulo.data.fuentes}
  tieneAfiliados={articulo.data.tieneAfiliados}
  encabezados={headings}
  minutos={minutos}
  palabras={palabras}
  ilustracion={articulo.data.ilustracion}
  ilustracionAlt={articulo.data.ilustracionAlt}
  resumen={articulo.data.resumen}
  faq={articulo.data.faq}
  temas={articulo.data.temas}
>
  <Content />
</Articulo>
